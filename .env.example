# Host port mapping for web service (default: 8000)
APP_PORT=8000
PORT=8000
HOST=0.0.0.0

# Persistent runtime data directory (SQLite database and run artifacts)
DATA_DIR=/app/data

# Database connection string (default: sqlite:////app/data/test_center.db)
# DATABASE_URL=sqlite:////app/data/test_center.db

# Test datasets directory (mounted read-only)
TEST_DATA_DIR=/app/test-data

# Dedicated Piston code execution runner sidecar (default: http://piston:2000)
PISTON_URL=http://piston:2000
PISTON_PORT=2000

# Path to static frontend assets
STATIC_DIR=/app/frontend/dist

# Optional notification settings (Webhook & SMTP Email)
# WEBHOOK_TIMEOUT_SECONDS=10.0
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=test-center@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Optional Bamboo / CI integration settings
# BAMBOO_API_TOKEN=your-ci-trigger-token
# BAMBOO_TOKEN_ENV_VAR=BAMBOO_API_TOKEN
# BAMBOO_BASE_URL=https://bamboo.example.com
# BAMBOO_USER=svc-bamboo
# BAMBOO_CREDS_ENV_VAR=BAMBOO_API_TOKEN


